  "title": "NUMA系统内存访问模拟",
  "language": "python",
  "code_lines": [
    "class Node:",
    "    def __init__(self, node_id):",
    "        self.node_id = node_id",
    "        self.local_memory = []",
    "        self.remote_access_delay = 0.5  # 秒",
    "",
    "class MemoryRegion:",
    "    def __init__(self, address, size, is_local=True):",
    "        self.address = address",
    "        self.size = size",
    "        self.is_local = is_local",
    "",
    "class NUMASystem:",
    "    def __init__(self, nodes):",
    "        self.nodes = nodes",
    "        self.memory_regions = []",
    "",
    "    def add_memory(self, address, size, is_local=True):",
    "        region = MemoryRegion(address, size, is_local)",
    "        self.memory_regions.append(region)",
    "",
    "    def access_memory(self, memory_addr):",
    "        for region in self.memory_regions:",
    "            if region.address <= memory_addr < region.address + region.size:",
    "                if region.is_local:",
    "                    return f\"Local Access ({region.address}-{region.address+region.size})\", 0.1",
    "                else:",
    "                    return f\"Remote Access ({region.address}-{region.address+region.size})\", region.remote_access_delay",
    "        return \"Invalid Address\", 0"
  ],
