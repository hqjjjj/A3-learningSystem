{
  "type": "code",
  "title": "动态分区分配-首次适应算法实现",
  "language": "python",
  "code_lines": [
    "class MemoryBlock:",
    "    def __init__(self, start, size):",
    "        self.start = start",
    "        self.size = size",
    "        self.allocated = False",
    "",
    "# 初始化内存空间(1000~2000)",
    "memory = [MemoryBlock(1000, 1000)]",
    "",
    "def first_fit_allocate(requested_size):",
    "    global memory",
    "    # 遍历空闲分区链表",
    "    for block in memory:",
    "        if not block.allocated and block.size >= requested_size:",
    "            # 分割内存块",
    "            new_block = MemoryBlock(block.start + requested_size, block.size - requested_size)",
    "            block.size = requested_size",
    "            block.allocated = True",
    "            return block.start",
    "    return None",
    "",
    "# 测试分配500字节",
    "addr1 = first_fit_allocate(500)",
    "print(f'分配地址: {addr1}')",
    "",
    "# 测试分配300字节",
    "addr2 = first_fit_allocate(300)",
    "print(f'分配地址: {addr2}')",
    "",
    "# 查看剩余空闲块",
    "for block in memory:",
    "    status = '已分配' if block.allocated else f'空闲({block.start},{block.size})'",
    "    print(status)"
  ],
  "description": "模拟首次适应算法的内存分配过程，通过遍历空闲分区链表选择首个满足需求的分区进行分配，体现低地址优先原则",
