  "code_lines": [
    "class MultiProcessorSystem:",
    "    def __init__(self):",
    "        self.systems = {",
    "            'master_slave': {'features': ['单OS副本', '主故障导致崩溃'], 'reliability': '低'},",
    "            'independent': {'features': ['独立OS副本', '自主性强'], 'load_balance': '差'},",
    "            'floating': {'features': ['可移动OS', '高可用性'], 'complexity': '最高'}",
    "        }",
    "    def show_types(self):",
    "        for name, info in self.systems.items():",
    "            print(f\"\\n{name.upper()}模式:\")",
    "            for key, value in info.items():",
    "                print(f\"  {key}: {value}\")"
  ],
