  "6e5bc40ed89b21e94069c0edf481c4cf": {
    "html_content": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody {\n  font-family: Arial, sans-serif;\n  margin: 0;\n  padding: 20px;\n  background: #f5f5f5;\n}\n.container {\n  max-width: 900px;\n  margin: 0 auto;\n  background: white;\n  border-radius: 10px;\n  box-shadow: 0 4px 6px rgba(0,0,0,0.1);\n  overflow: hidden;\n}\nh1 {\n  text-align: center;\n  color: #333;\n  padding: 20px;\n}\n.canvas-container {\n  position: relative;\n  width: 100%;\n  height: 400px;\n}\ncanvas {\n  display: block;\n  background: #fff;\n  border: 1px solid #ddd;\n}\n.controls {\n  padding: 15px;\n  text-align: center;\n  background: #f9f9f9;\n}\nbutton {\n  padding: 8px 16px;\n  margin: 0 5px;\n  background: #4CAF50;\n  color: white;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n}\nbutton:hover {\n  background: #45a049;\n}\n.info-panel {\n  padding: 15px;\n  background: #e8f4fd;\n  border-top: 1px solid #ddd;\n}\n.legend {\n  display: flex;\n  justify-content: center;\n  gap: 20px;\n  margin-top: 10px;\n}\n.legend-item {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n}\n.color-box {\n  width: 20px;\n  height: 20px;\n  border-radius: 3px;\n}\n</style>\n</head>\n<body>\n<div class=\"container\">\n  <h1>页表映射可视化</h1>\n  <div class=\"canvas-container\">\n    <canvas id=\"pageTableCanvas\" width=\"860\" height=\"350\"></canvas>\n  </div>\n  <div class=\"controls\">\n    <button onclick=\"prevPage()\">上一页</button>\n    <button onclick=\"nextPage()\">下一页</button>\n    <button onclick=\"autoPlay()\">自动播放</button>\n    <span id=\"currentPage\">当前页: 1</span>\n  </div>\n  <div class=\"info-panel\">\n    <strong>操作说明：</strong>\n    <ul>\n      <li>点击页号可查看映射关系</li>\n      <li>使用按钮切换不同页面</li>\n      <li>自动播放模式展示完整映射</li>\n    </ul>\n    <div class=\"legend\">\n      <div class=\"legend-item\">\n        <div class=\"color-box\" style=\"background:#ff6b6b;\"></div>\n        <span>逻辑页号</span>\n      </div>\n      <div class=\"legend-item\">\n        <div class=\"color-box\" style=\"background:#4ecdc4;\"></div>\n        <span>物理页框</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\nconst canvas = document.getElementById('pageTableCanvas');\nconst ctx = canvas.getContext(''2d'');\n\n// 页表数据\nconst pageTable = [\n  { logical: 1, physical: 5, description: '页号1 → 页框5' },\n  { logical: 2, physical: 8, description: '页号2 → 页框8' },\n  { logical: 3, physical: 3, description: '页号3 → 页框3' },\n  { logical: 4, physical: 7, description: '页号4 → 页框7' },\n  { logical: 5, physical: 2, description: '页号5 → 页框2' }\n];\n\nlet currentIndex = 0;\nlet animationId;\n\nfunction drawPageTable() {\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n  \n  // 标题\n  ctx.fillStyle = '#333';\n  ctx.font = 'bold 18px Arial';\n  ctx.textAlign = 'center';\n  ctx.fillText('页表映射示例', canvas.width/2, 30);\n  \n  // 左侧：逻辑地址\n  ctx.fillStyle = '#ff6b6b';\n  ctx.font = 'bold 16px Arial';\n  ctx.textAlign = 'left';\n  ctx.fillText('逻辑地址空间:', 50, 80);\n  \n  // 绘制逻辑页\n  for (let i = 0; i < pageTable.length; i++) {\n    let y = 110 + i * 40;\n    ctx.strokeStyle = '#ff6b6b';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.roundRect(50, y, 150, 30, 5);\n    ctx.stroke();\n    \n    ctx.fillStyle = '#333';\n    ctx.font = '14px Arial';\n    ctx.fillText(`页${i+1}`, 65, y + 20);\n  }\n  \n  // 右侧：物理地址\n  ctx.fillStyle = '#4ecdc4';\n  ctx.fillText('物理内存:', canvas.width - 200, 80);\n  \n  for (let i = 0; i < pageTable.length; i++) {\n    let y = 110 + i * 40;\n    ctx.strokeStyle = '#4ecdc4';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.roundRect(canvas.width - 180, y, 150, 30, 5);\n    ctx.stroke();\n    \n    ctx.fillStyle = '#333';\n    ctx.font = '14px Arial';\n    ctx.fillText(`页框${pageTable[i].physical}`, canvas.width - 165, y + 20);\n  }\n  \n  // 箭头\n  ctx.strokeStyle = '#666';\n  ctx.lineWidth = 2;\n  ctx.setLineDash([5, 5]);\n  ctx.beginPath();\n  ctx.moveTo(200, 175);\n  ctx.lineTo(canvas.width - 200, 175);\n  ctx.stroke();\n  ctx.setLineDash([]);\n  \n  // 当前选中的页\n  const selected = pageTable[currentIndex];\n  ctx.fillStyle = '#2c3e50';\n  ctx.fillRect(50, 230, canvas.width - 100, 60);\n  \n  ctx.fillStyle = '#fff';\n  ctx.font = 'bold 16px Arial';\n  ctx.textAlign = 'center';\n  ctx.fillText(`当前映射: ${selected.logical} → ${selected.physical}`, canvas.width/2, 260);\n  \n  ctx.font = '14px Arial';\n  ctx.fillText(`描述: ${selected.description}`, canvas.width/2, 285);\n  \n  // 更新显示\n  document.getElementById('currentPage').textContent = `当前页: ${currentIndex + 1}`;\n}\n\nfunction nextPage() {\n  if (currentIndex < pageTable.length - 1) {\n    currentIndex++;\n    drawPageTable();\n  }\n}\n\nfunction prevPage() {\n  if (currentIndex > 0) {\n    currentIndex--;\n    drawPageTable();\n  }\n}\n\nfunction autoPlay() {\n  clearInterval(animationId);\n  let index = 0;\n  animationId = setInterval(() => {\n    if (index >= pageTable.length) {\n      clearInterval(animationId);\n      return;\n    }\n    currentIndex = index;\n    drawPageTable();\n    index++;\n  }, 2000);\n}\n\n// 初始化\ndrawPageTable();\n\n// 点击事件\ncanvas.addEventListener('click', function(e) {\n  const rect = canvas.getBoundingClientRect();\n  const x = e.clientX - rect.left;\n  const y = e.clientY - rect.top;\n  \n  // 检查是否点击了逻辑页\n  for (let i = 0; i < pageTable.length; i++) {\n    if (x > 50 && x < 200 && y > 110 + i*40 && y < 140 + i*40) {\n      currentIndex = i;\n      drawPageTable();\n      break;\n    }\n  }\n});\n</script>\n</body>\n</html>",
    "title": "页表映射可视化",
    "description": "本动画通过可视化方式展示页表的映射机制。左侧显示逻辑页号（红色），右侧显示对应的物理页框（青色）。用户可以点击任意页号查看其映射关系，也可以使用按钮切换不同页面。自动播放模式会循环展示所有映射关系，帮助学生直观理解页表在地址转换中的核心作用。",
    "created_at": 1780035064.9184453
  },
  "7e03994f00ac74343c2ba1786bed3dae": {
    "html_content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>连续分配存储管理</title>\n    <style>\n        * { margin:0; padding:0; box-sizing:border-box; }\n        body {\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            min-height: 100vh;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            padding: 20px;\n            color: #333;\n        }\n        .container {\n            max-width: 1200px;\n            width: 100%;\n            background: white;\n            border-radius: 20px;\n            box-shadow: 0 20px 60px rgba(0,0,0,0.3);\n            overflow: hidden;\n        }\n        header {\\n            background: linear-gradient(90deg, #2c3e50, #3498db);\\n            color: white;\\n            padding: 25px;\\n            text-align: center;\\n        }\n        h1 {\n            font-size: 2.2em;\n            margin-bottom: 10px;\n            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);\n        }\n        .subtitle {\\n            font-size: 1.1em;\\n            opacity: 0.9;\\n        }\n        .main-content {\n            display: grid;\n            grid-template-columns: 1fr 300px;\n            gap: 20px;\n            padding: 25px;\n        }\n        .canvas-container {\n            position: relative;\n            background: #f8f9fa;\n            border-radius: 15px;\n            padding: 20px;\n            box-shadow: inset 0 0 20px rgba(0,0,0,0.05);\n        }\n        canvas {\\n            border: 2px solid #ddd;\\n            border-radius: 10px;\\n            background: white;\\n            cursor: crosshair;\\n        }\n        .controls {\n            background: #ecf0f1;\n            border-radius: 15px;\n            padding: 20px;\n            display: flex;\n            flex-direction: column;\n            gap: 15px;\n        }\n        .control-group {\n            background: white;\n            padding: 15px;\n            border-radius: 10px;\n            box-shadow: 0 4px 6px rgba(0,0,0,0.1);\n        }\n        .control-group h3 {\\n            margin-bottom: 12px;\\n            color: #2c3e50;\\n            font-size: 1.1em;\\n        }\n        .btn-group {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 8px;\n        }\n        button {\n            padding: 10px 16px;\n            border: none;\n            border-radius: 8px;\n            background: linear-gradient(135deg, #3498db, #2980b9);\n            color: white;\n            font-weight: bold;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            flex: 1;\n            min-width: 120px;\n        }\n        button:hover {\\n            transform: translateY(-2px);\\n            box-shadow: 0 5px 15px rgba(0,0,0,0.2);\\n        }\n        button.active {\n            background: linear-gradient(135deg, #e74c3c, #c0392b);\n        }\n        .info-panel {\\n            background: white;\\n            padding: 15px;\\n            border-radius: 10px;\\n            margin-top: 10px;\\n            box-shadow: 0 4px 6px rgba(0,0,0,0.1);\\n        }\n        .legend {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 10px;\n            margin-top: 10px;\n        }\n        .legend-item {\n            display: flex;\n            align-items: center;\n            gap: 5px;\n            font-size: 0.9em;\n        }\n        .legend-color {\n            width: 20px;\n            height: 20px;\n            border-radius: 4px;\n        }\n        .stats {\n            margin-top: 15px;\n            padding-top: 15px;\n            border-top: 1px dashed #ccc;\n        }\n        .stat-row {\n            display: flex;\n            justify-content: space-between;\n            margin: 8px 0;\n            font-size: 0.95em;\n        }\n        .tooltip {\n            position: absolute;\n            background: rgba(0,0,0,0.8);\n            color: white;\n            padding: 8px 12px;\n            border-radius: 6px;\n            font-size: 0.9em;\n            pointer-events: none;\n            z-index: 100;\n            opacity: 0;\n            transition: opacity 0.3s;\n        }\n        .algorithm-desc {\\n            line-height: 1.6;\\n            font-size: 0.95em;\\n        }\n        .highlight {\n            background: yellow;\n            padding: 2px 4px;\n            border-radius: 3px;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>📊 连续分配存储管理方式</h1>\n            <p class=\"subtitle\">动态分区分配算法可视化演示 | First Fit / Best Fit / Worst Fit / Next Fit</p>\n        </header>\n\n        <div class=\"main-content\">\n            <div class=\"canvas-container\">\n                <canvas id=\"memoryCanvas\" width=\"800\" height=\"400\"></canvas>\n                <div class=\"tooltip\" id=\"tooltip\"></div>\n            </div>\n\n            <div class=\"controls\">\n                <div class=\"control-group\">\n                    <h3>📍 选择算法</h3>\n                    <div class=\"btn-group\">\n                        <button onclick=\"selectAlgorithm('ff')\" id=\"btn-ff\">首次适应 (FF)</button>\n                        <button onclick=\"selectAlgorithm('bf')\" id=\"btn-bf\">最佳适应 (BF)</button>\n                    </div>\n                    <div class=\"btn-group\">\n                        <button onclick=\"selectAlgorithm('wf')\" id=\"btn-wf\">最坏适应 (WF)</button>\n                        <button onclick=\"selectAlgorithm('nf')\" id=\"btn-nf\">循环首次适应 (NF)</button>\n                    </div>\n                </div>\n\n                <div class=\"control-group\">\n                    <h3>⚙️ 操作控制</h3>\n                    <div class=\"btn-group\">\n                        <button onclick=\"startDemo()\">▶ 开始演示</button>\n                        <button onclick=\"resetMemory()\">↺ 重置</button>\n                    </div>\n                    <div class=\"btn-group\">\n                        <button onclick=\"toggleAutoPlay()\">🔄 自动循环</button>\n                        <button onclick=\"addProcess()\">➕ 添加进程</button>\n                    </div>\n                </div>\n\n                <div class=\"info-panel\">\n                    <h3>📚 算法说明</h3>\n                    <div class=\"algorithm-desc\">\n                        <p><strong>首次适应(FF):</strong> 从低地址开始查找第一个能满足要求的空闲区。<br>\n                        <strong>最佳适应(BF):</strong> 遍历整个空闲区链表，找到能满足请求的最小空闲区。<br>\n                        <strong>最坏适应(WF):</strong> 总是选择最大的空闲区进行分配。<br>\n                        <strong>循环首次适应(NF):</strong> 从上次分配的位置开始查找。</p>\n                    </div>\n\n                    <div class=\"legend\">\n                        <div class=\"legend-item\">\n                            <div class=\"legend-color\" style=\"background:#e74c3c;\"></div>\n                            <span>已分配</span>\n                        </div>\n                        <div class=\"legend-item\">\n                            <div class=\"legend-color\" style=\"background:#3498db;\"></div>\n                            <span>空闲区</span>\n                        </div>\n                        <div class=\"legend-item\">\n                            <div class=\"legend-color\" style=\"background:#2ecc71;\"></div>\n                            <span>新进程</span>\n                        </div>\n                    </div>\n\n                    <div class=\"stats\">\n                        <div class=\"stat-row\">\n                            <span>总内存大小:</span>\n                            <span>1024KB</span>\n                        </div>\n                        <div class=\"stat-row\">\n                            <span>空闲区数量:</span>\n                            <span id=\"freeBlocks\">0</span>\n                        </div>\n                        <div class=\"stat-row\">\n                            <span>碎片率:</span>\n                            <span id=\"fragmentation\">0%</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        const canvas = document.getElementById('memoryCanvas');\n        const ctx = canvas.getContext('2d');\n        const tooltip = document.getElementById('tooltip');\n\n        // 内存配置\n        const MEMORY_SIZE = 1024;\n        const BLOCK_HEIGHT = 40;\n        const PADDING = 20;\n\n        // 状态变量\n        let freeBlocks = [];\n        let allocatedBlocks = [];\n        let currentAlgorithm = 'ff';\n        let isAnimating = false;\n        let autoPlayInterval = null;\n\n        // 初始化内存\n        function initMemory() {\n            freeBlocks = [{ start: 0",
    "title": "连续分配存储管理方式 - 动态分区分配算法对比",
    "description": "本动画演示了连续分配存储管理中的四种动态分区分配算法：\n\n1. **首次适应(FF)**: 从低地址开始查找第一个能满足需求的空闲区\n2. **最佳适应(BF)**: 寻找能满足需求的最小空闲区\n3. **最坏适应(WF)**: 总是选择最大的空闲区进行分配\n4. **循环首次适应(NF)**: 从上次分配的位置开始查找\n\n**交互功能**:\n- 点击按钮选择不同算法\n- 开始演示自动分配多个进程\n- 手动添加随机大小的进程\n- 鼠标悬停查看进程详细信息\n- 实时显示碎片率统计\n\n**教学价值**: 通过可视化对比不同算法的处理过程，帮助学生理解各种算法的特点和适用场景。",
    "created_at": 1780037522.0565925
  }
